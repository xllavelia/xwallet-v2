
.header{
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: row;
  padding: 1rem;
  padding-top: 0 ;
}

.header-text{
  display: flex;
  align-items: center;
color: hsl(70, 80%, 80%);
background-color: hsl(162, 50%, 17%);
  font-family: 'Unbounded', sans-serif;
  font-size: 2rem;
  font-weight: 900;
  opacity: 1;
}

.home-cart-parent{
  display: flex;
  justify-content: center;
   margin-top: 0vh;
   gap: 0.8rem;
   opacity: 1;
}

.home-cart{
background-color: hsl(162, 50%, 17%);
  /* height: 21vh; */
  width: 73%;
  border-radius: 0.3rem;
}

.balance{
  padding: 0.5rem ;
  padding-top: 0rem;
  color: hsl(70, 80%, 80%);
    font-family:'Unbounded', sans-serif;
  font-size: 3.3rem;
letter-spacing: -1px;
  font-weight:900; 
  opacity: 1;
}

.name-cart{
  color: hsl(70, 80%, 80%);
  font-family:'Inter', sans-serif;
  font-size: 0.9rem;
  font-weight: 700;
  opacity: 0;
  padding: 0.1rem;
}

.balance-text{
  color: hsl(69, 18%, 92%);
    font-family:'Unbounded', sans-serif;
  font-size: 1rem;
  font-weight: 500;
  opacity: 0.8;
  padding-left:0.5rem;
}

.number-cart{
  color: hsl(72, 12%, 92%);
  font-family:'Unbounded', sans-serif;
  font-size: 0.9rem;
  font-weight: 600;
  opacity: .9;
  text-align: center;
}

.cart-id{
  margin-top: 0.1rem;
  text-align: center;
  color: hsl(70, 21%, 95%);
  font-family:'Unbounded', sans-serif;
  font-size: 0.8rem;
  font-weight: 500;
  opacity: 0.8;
   padding-bottom: 1.7rem;
}

.trade-details-dropdown-home {
  font-family:'Unbounded', sans-serif;
padding: 1rem;
  margin-top: -5px;
  margin-bottom: -1rem;
  padding-top: 15px;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}
.detail-row-home { 
  color: hsl(69, 18%, 92%);
  display: flex; justify-content: space-between; font-size: .8rem; font-weight: 700; margin-bottom: 6px; }


.not-cart {
  gap:0.5rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between; 
  width: 15%; 
}

.cart-nwc {
  border-radius: 0.3rem;
  width: 100%; 
  height: 70%;
  background-color: hsl(70, 80%, 80%);
}


.create-cart {
   border-radius: 0.3rem;
  display: flex;
  justify-content: center; 
  align-items: center;     
  width: 100%;
  height: 30%;
  overflow: hidden;
  background-color: hsl(162, 50%, 17%);
}


.actions-floating-grid-home {
  display: flex;
  justify-content: center;
  gap: 25px;
  margin: 30px;
}

.action-circle-home {
   color: hsl(70, 21%, 95%);
  font-family:'Unbounded', sans-serif;
  font-size: 0.8rem;
  font-weight: 500;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  cursor: pointer;
  width: 100%;
}

.action-circle-home .icon-home {
 width: 110%;
  height: 60px;
  border-radius: 20px;
  background: #0D0E10;
  color: hsl(70, 80%, 80%);
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 1.4rem;
  border: 1px solid rgba(255, 255, 255, 0.05);
  transition: 0.3s;
}
.action-circle.primary-home .icon-home {
   background: hsl(162, 50%, 20%); border: none; }
.action-circle-home span { font-size: 0.8rem; font-weight: 800; text-transform: uppercase; }


.show{display: block;}
.hide{display: none;}

.trade-details-dropdown-home-button {
  font-family:'Unbounded', sans-serif;
  width: 90%;
padding: 0rem;
  margin-top: -5px;
  margin-bottom: 0rem;
  padding-top: 15px;
}



.crypto-mini-cards-container {
   overflow-x: auto ;
 overflow-y: hidden ;
 scroll-snap-type: x mandatory;
scrollbar-width: none;
scroll-behavior: smooth;
justify-content: start;
  margin: 5%;
margin-top: 3vh;
  display: flex;
  gap: 15px; 
  background-color: #000000;
  padding: 0px;
  border-radius: 12px;
}

.crypto-mini-card {
  background-color: #0D0E10; 
  color: #FFFFFF; 
  font-family: 'Unbounded', sans-serif; 
  border-radius: 12px; 
  padding: 15px; 
  display: flex;
  flex-direction: column;
 min-width: 35vh;

}

/* Стили для заголовка карточки */
.mini-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between; /* Распределяем элементы по краям */
  margin-bottom: 0.4rem;
}



.mini-card-title {
  font-size: 16px;
  color: #FFFFFF;
  font-weight: bold;
}

.mini-card-rate {
  font-size: 12px;
  color: hsl(70, 80%, 80%);
}

.mini-card-balance-section {
  margin-top: 0.5rem;
  margin-bottom: -2px;
}

/* Стили для криптовалютного баланса */
.mini-card-crypto-balance {
  font-size: 24px;
  font-weight: bold;
  color: #FFFFFF;
}

/* Стили для эквивалента в USD */
.mini-card-fiat-balance {
  opacity: 0;
  font-size: 14px;
  color: hsl(70, 80%, 80%);
  opacity: 0; /* Светло-серый цвет текста */
}

/* Стили для секции прибыли */
.mini-card-profit-section {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 15px;
  opacity: 0.5;
}

/* Стили для текста заголовка прибыли */
.mini-card-profit-title {
  font-size: 12px;
  color: #9CA3AF;
}

/* Стили для прибыли в USD */
.mini-card-profit-usd {
  font-size: 14px;
  color: #10B981; /* Зеленый цвет для прибыли */
}

/* Стили для процентного прироста прибыли */
.mini-card-profit-percent {
  font-size: 14px;
  color: hsl(70, 80%, 80%); /* Фирменный акцентный цвет для процентов */
}

/* Стили для кнопок действий */
.mini-card-actions {
  display: flex;
  gap: 8px; /* Отступ между кнопками */
  justify-content: space-between;
}

/* Стили для общей кнопки */
.btn-mini-card {
  flex: 1; /* Кнопки занимают все доступное место */
  text-align: center;
  border-radius: 8px;
  padding: 8px;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase; /* Текст в верхнем регистре */
  border: none;
  cursor: pointer;
}

.btn-swap { 
  background-color: transparent; 
  border: 2px solid hsl(70, 80%, 80%); 
  color: hsl(70, 80%, 80%); 
  font-family: 'Unbounded', sans-serif; 
}

.btn-buy { 
  background-color:
    hsl(70, 80%, 80%); 
    color: #000000;
  font-family: 'Unbounded', sans-serif; 
   } 

.btn-send {
   background-color:  
   hsl(70, 80%, 80%); 
   color: #000000; 
  font-family: 'Unbounded', sans-serif; 
  }
  
.home-history-wrapper-parent {
  margin-top: 1.5rem;
display: flex;
justify-content: center;
}
  
.home-history-wrapper {
  background-color: #0D0E10;
  border-radius: 20px;
  padding: 24px;
  font-family: 'Unbounded', sans-serif;
  width: 95%;
  box-sizing: border-box;
}

 
.home-history-wrapper img {
width: 100%;
height: 100%;
border-radius: 20%;
border: 1px solid #ffffff ;
}


.home-history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.home-history-title {
  color: #FFFFFF;
  font-size: 1.2rem;
  font-weight: 700;
  margin: 0;
  letter-spacing: -0.5px;
}

.home-history-see-all {
  color: hsl(70, 80%, 80%); /* Твой фирменный салатовый */
  font-size: 0.9rem;
  font-weight: 700;
  cursor: pointer;
  transition: opacity 0.2s ease;
}

.home-history-see-all:active {
  opacity: 0.5; /* Легкая анимация нажатия */
}

/* Контейнер списка */
.home-history-list {
  display: flex;
  flex-direction: column;
  gap: 16px; /* Отступ между транзакциями */
}

/* Сама карточка транзакции */
.home-history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05); /* Легкая разделительная линия */
}

/* Убираем линию у последней карточки */
.home-history-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

/* Группировка левой части */
.home-history-left {
  display: flex;
  align-items: center;
  gap: 16px;
}

/* Кружок с картинкой */
.home-history-img {
  width: 50px;
  height: 50px;
  background-color: transparent; /* Твой фирменный изумрудно-темный */
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 1.5rem;
}

/* Информация (Имя и Дата) */
.home-history-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.home-history-name {
  color: #FFFFFF;
  font-size: 1rem;
  font-weight: 700;
  margin: 0;
}

.home-history-date {
  color: rgba(255, 255, 255, 0.4); /* Выцветший серый для даты */
  font-size: 0.8rem;
  font-weight: 400;
}

/* Правая часть (Суммы) */
.home-history-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end; /* Выравниваем по правому краю */
  gap: 6px;
}

.home-history-amount {
  color: #FFFFFF;
  font-size: 1.1rem;
  font-weight: 700;
  margin: 0;
  letter-spacing: -0.5px;
}

/* Плашка кэшбека */
.home-history-bonus {
  background-color: hsl(70, 80%, 80%);
  color: #0D0E10; /* Темный текст для читаемости на салатовом фоне */
  font-size: 0.75rem;
  font-weight: 700;
  padding: 4px 8px;
  border-radius: 8px;
}
